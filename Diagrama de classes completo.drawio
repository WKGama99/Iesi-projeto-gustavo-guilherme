<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="DzZxI76v2sT3QRSnY0Ib">
    <mxGraphModel dx="1243" dy="-368" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sistema de Logística e Expedição B2B\n\nhide circle\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam linetype ortho\n\n&#39; =========================\n&#39; Classes principais\n&#39; =========================\n\nclass Produto {\n  idProduto: int\n  referencia: String\n  descricao: String\n  peso: decimal\n  comprimento: decimal\n  largura: decimal\n  altura: decimal\n  stock: int\n  categoria: String\n\n  atualizarStock(quantidade: int): void\n  calcularVolume(): decimal\n}\n\nclass Cliente {\n  idCliente: int\n  nome: String\n  nif: String\n  morada: String\n  contacto: String\n\n  atualizarDados(): void\n}\n\nclass OrdemExpedicao {\n  idOrdem: int\n  dataCriacao: DateTime\n  estado: EstadoOrdem\n\n  adicionarProduto(produto: Produto, quantidade: int): void\n  removerProduto(produto: Produto): void\n  alterarEstado(estado: EstadoOrdem): void\n  calcularPesoTotal(): decimal\n}\n\nclass ItemExpedicao {\n  idItem: int\n  quantidade: int\n\n  calcularPeso(): decimal\n}\n\nclass Palete {\n  idPalete: int\n  pesoTotal: decimal\n  volumeTotal: decimal\n  codigoQR: String\n  estado: EstadoPalete\n\n  adicionarProduto(produto: Produto): void\n  removerProduto(produto: Produto): void\n  calcularPesoTotal(): decimal\n  calcularVolumeTotal(): decimal\n}\n\nclass ItemPalete {\n  idItemPalete: int\n  quantidade: int\n\n  calcularPeso(): decimal\n  calcularVolume(): decimal\n}\n\nclass Etiqueta {\n  idEtiqueta: int\n  codigoBarras: String\n  dataGeracao: DateTime\n\n  gerarEtiqueta(): void\n  imprimirEtiqueta(): void\n}\n\nclass GuiaTransporte {\n  idGuia: int\n  dataEmissao: DateTime\n  estado: EstadoGuia\n\n  emitirGuia(): void\n  alterarEstado(estado: EstadoGuia): void\n}\n\nclass Transportadora {\n  idTransportadora: int\n  nome: String\n  nif: String\n  morada: String\n\n  atualizarDados(): void\n}\n\nclass Veiculo {\n  matricula: String\n  capacidadePeso: decimal\n  capacidadeVolume: decimal\n  estado: EstadoVeiculo\n\n  verificarCapacidade(peso: decimal, volume: decimal): boolean\n  alterarEstado(estado: EstadoVeiculo): void\n}\n\nclass Tracking {\n  idTracking: int\n  dataHora: DateTime\n  estado: EstadoTracking\n  observacao: String\n\n  registarEvento(): void\n}\n\n&#39; =========================\n&#39; Enumerações\n&#39; =========================\n\nenum EstadoOrdem {\n  CRIADA\n  EM_PROCESSAMENTO\n  EMPALETADA\n  EXPEDIDA\n  CONCLUIDA\n  CANCELADA\n}\n\nenum EstadoPalete {\n  EM_PREPARACAO\n  FECHADA\n  CARREGADA\n  EM_TRANSITO\n  ENTREGUE\n}\n\nenum EstadoGuia {\n  EM_PREPARACAO\n  EMITIDA\n  EM_TRANSITO\n  CONCLUIDA\n  CANCELADA\n}\n\nenum EstadoVeiculo {\n  DISPONIVEL\n  EM_CARGA\n  EM_TRANSITO\n  INDISPONIVEL\n  MANUTENCAO\n}\n\nenum EstadoTracking {\n  EM_PROCESSAMENTO\n  EMPALETADO\n  CARREGADO\n  EM_TRANSITO\n  ENTREGUE\n  OCORRENCIA\n}\n\n&#39; =========================\n&#39; Relações\n&#39; =========================\n\nCliente \&quot;1\&quot; -- \&quot;0..*\&quot; OrdemExpedicao : realiza &gt;\n\nOrdemExpedicao \&quot;1\&quot; *-- \&quot;1..*\&quot; ItemExpedicao : contém &gt;\nProduto \&quot;1\&quot; -- \&quot;0..*\&quot; ItemExpedicao : corresponde a &gt;\n\nOrdemExpedicao \&quot;1\&quot; *-- \&quot;0..*\&quot; Palete : origina &gt;\n\nPalete \&quot;1\&quot; *-- \&quot;1..*\&quot; ItemPalete : contém &gt;\nProduto \&quot;1\&quot; -- \&quot;0..*\&quot; ItemPalete : corresponde a &gt;\n\nPalete \&quot;1\&quot; *-- \&quot;1\&quot; Etiqueta : possui &gt;\n\nOrdemExpedicao \&quot;1\&quot; -- \&quot;0..1\&quot; GuiaTransporte : gera &gt;\n\nTransportadora \&quot;1\&quot; -- \&quot;0..*\&quot; GuiaTransporte : responsável por &gt;\nTransportadora \&quot;1\&quot; o-- \&quot;0..*\&quot; Veiculo : possui &gt;\n\nVeiculo \&quot;1\&quot; -- \&quot;0..*\&quot; GuiaTransporte : utilizado em &gt;\n\nGuiaTransporte \&quot;1\&quot; *-- \&quot;0..*\&quot; Tracking : possui &gt;\nPalete \&quot;1\&quot; -- \&quot;0..*\&quot; Tracking : rastreada por &gt;\n\n&#39; =========================\n&#39; Notas\n&#39; =========================\n\nnote right of ItemExpedicao\n  Classe associativa entre\n  OrdemExpedicao e Produto.\n\n  Permite indicar a quantidade\n  de cada produto na ordem.\nend note\n\nnote right of ItemPalete\n  Classe associativa entre\n  Palete e Produto.\n\n  Permite indicar a quantidade\n  de cada produto colocado\n  numa palete.\nend note\n\nnote bottom of Tracking\n  Regista o histórico dos estados\n  e das ocorrências da expedição.\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="-YUPVpTsmB-q_3gpfjgV-501">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10 10 180 10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
